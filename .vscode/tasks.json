{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"command": "/usr/bin/bash",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$rustc"
			],
			"label": "run",
			"args": [
				"${workspaceFolder}/runner-debug.sh",
				"${relativeFile}"
			]
		},
		{
			"type": "process",
			"command": "/usr/bin/bash",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$rustc"
			],
			"label": "run release",
			"args": [
				"${workspaceFolder}/runner.sh",
				"${relativeFile}"
			]
		}
	]
}
